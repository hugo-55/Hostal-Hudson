# Copia este archivo como .env.local y completa solo lo que uses.
# Nunca commitees el .env.local: los valores reales van en Vercel o en el vault.

# Clave de acceso del panel del dueño (servidor). Sin valor, el login falla cerrado.
ADMIN_KEY=

# Apps Script publicado para guardar y leer el estado del panel (clave de admin disponible).
ADMIN_STATE_URL=

# API key de Google Places para las reseñas en vivo (solo servidor). Vacía = reseñas de ejemplo.
GOOGLE_PLACES_API_KEY=

# 1 = redirigir .vercel.app al dominio canónico (308). Activo solo el día del corte.
CANONICAL_REDIRECT=

# 1 = sitio en noindex (robots noindex, nofollow) durante el preview. Se quita el día del corte.
SITE_PREVIEW=
